  "layout_rules": [
    {
      "id": "cover-dark",
      "priority": 1000,
      "conditions": { "type": "cover", "bg_is_dark": true },
      "layout": "Cover_Dark",
      "decision_path": ["type=cover", "bg_is_dark=true", "→ layout=Cover_Dark"]
    },
    {
      "id": "cover-light",
      "priority": 999,
      "conditions": { "type": "cover" },
      "layout": "Cover_Light",
      "decision_path": ["type=cover", "→ layout=Cover_Light"]
    },
    {
      "id": "divider-dark",
      "priority": 900,
      "conditions": { "type": "divider", "bg_is_dark": true },
      "layout": "Divider_Dark",
      "decision_path": ["type=divider", "bg_is_dark=true", "→ layout=Divider_Dark"]
    },
    {
      "id": "divider-light",
      "priority": 899,
      "conditions": { "type": "divider" },
      "layout": "Divider_Crystal",
      "decision_path": ["type=divider", "→ layout=Divider_Crystal"]
    },
    {
      "id": "ending",
      "priority": 800,
      "conditions": { "type": "ending" },
      "layout": "Ending_PivotPurple",
      "decision_path": ["type=ending", "→ layout=Ending_PivotPurple"]
    },
    {
      "id": "content-subtitle-dark",
      "priority": 760,
      "conditions": { "type": "content", "has_subtitle": true, "bg_is_dark": true },
      "layout": "Content_Dark_Sub",
      "decision_path": ["type=content", "has_subtitle=true", "bg_is_dark=true", "→ layout=Content_Dark_Sub"]
    },
    {
      "id": "content-subtitle-light",
      "priority": 759,
      "conditions": { "type": "content", "has_subtitle": true },
      "layout": "Content_Light_Sub",
      "decision_path": ["type=content", "has_subtitle=true", "→ layout=Content_Light_Sub"]
    },
    {
      "id": "content-dark",
      "priority": 700,
      "conditions": { "type": "content", "bg_is_dark": true },
      "layout": "1_Content_Dark",
      "decision_path": ["type=content", "bg_is_dark=true", "→ layout=1_Content_Dark"]
    },
    {
      "id": "content-sparse-visual",
      "priority": 600,
      "conditions": { "type": "content", "text_density": "low", "has_chart": false, "image_count_gt": 0 },
      "layout": "Title_Only_Light",
      "decision_path": ["type=content", "text_density=low", "has_chart=false", "image_count>0", "→ layout=Title_Only_Light"]
    },
    {
      "id": "content-default",
      "priority": 100,
      "conditions": { "type": "content" },
      "layout": "Content_Light",
      "decision_path": ["type=content", "→ layout=Content_Light"]
    }
  ]
